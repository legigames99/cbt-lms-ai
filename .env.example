# ============================================================================
# CBT & LMS Terintegrasi AI - Environment Variables Template
# ============================================================================

# Aplikasi & Server
APP_ENV=production
APP_PORT=8080
GOMEMLIMIT=250MiB
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_long_12345
STATIC_PACKAGE_DIR=./static/packages

# Database PostgreSQL 16+
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cbt_user
DB_PASSWORD=secret_cbt_pass
DB_NAME=cbt_lms_db
DB_SSLMODE=disable
DB_POOL_MAX_CONNS=80
DB_POOL_MIN_CONNS=10

# In-Memory Cache (Redis 7.2+)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Provider (Google Gemini / OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-2.5-flash

# Object Storage (Cloudflare R2 / AWS S3 Direct Upload)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=school-cbt-lms
R2_PUBLIC_DOMAIN=https://static.sekolah.sch.id
